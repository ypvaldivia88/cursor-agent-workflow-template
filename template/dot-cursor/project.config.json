{
  "projectName": "MyProject",
  "developerName": "Your Name",
  "developerGitHub": "your-github-handle",
  "issueKeyPrefixes": ["PROJ"],
  "defaultBaseBranch": "main",
  "releaseBranchPattern": "release-*",
  "issueTracker": {
    "product": "generic",
    "notes": "Document in PROJECT.md: MCP server id, API, or how agents load issues."
  },
  "dailyReport": {
    "filePattern": "Developer_Report_YYYY-MM-DD.md",
    "authorLabel": "Developer",
    "targetHoursPerDay": 6
  },
  "sessionStart": {
    "chatTitleDateOnly": true,
    "optionalDigests": []
  },
  "pr": {
    "defaultReviewers": ["teammate-a", "teammate-b"],
    "squashMerge": true
  },
  "integrations": {
    "scm": "github",
    "issueTrackerMcp": null,
    "chatMcp": null
  },
  "paths": {
    "codingStandards": "docs/coding-standards/",
    "features": "docs/features/",
    "ciReadme": ".github/README.md"
  }
}
